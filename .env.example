# Optional local service configuration. Setup prepares .mailguard/.env.
# Fill credentials on this computer; never send them to chat or Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONCURRENCY=20
EVAL_PROGRESS_TIMEOUT_SECONDS=300
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_CONCURRENCY=5
GLM_THINKING=enabled
GLM_MAX_TOKENS=4500
# Coding Plan Chat Completions: https://open.bigmodel.cn/api/coding/paas/v4
# For glm-5.3, set GLM_THINKING=enabled and GLM_REASONING_EFFORT=low
GLM_REASONING_EFFORT=low
# For a Z.ai international key, use https://api.z.ai/api/paas/v4/
# Optional GPT adapter
GPT_API_KEY=
GPT_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-4.1-mini
# Ask the mailbox provider for IMAP_HOST; confirm the folder before filling it.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=
